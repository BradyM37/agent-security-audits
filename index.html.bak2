<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Enterprise AI security audits for chatbots, autonomous agents, and LLM systems. 100+ vulnerability patterns tested. Comprehensive red-team testing with CVSS scoring and remediation guidance.">
    <meta name="keywords" content="AI security audit, prompt injection testing, LLM security, chatbot vulnerability assessment, AI agent red team, SAST for AI, prompt engineering security">
    <meta name="robots" content="index, follow">
    <meta name="author" content="PromptGuard">
    <meta name="language" content="English">
    
    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://prompt-guard.netlify.app/">
    <meta property="og:title" content="PromptGuard | Enterprise AI Security Audits">
    <meta property="og:description" content="Find vulnerabilities in your AI systems before attackers do. Specialized security testing for LLMs, chatbots, and autonomous agents.">
    <meta property="og:site_name" content="PromptGuard">
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://prompt-guard.netlify.app/">
    <meta property="twitter:title" content="PromptGuard | Enterprise AI Security Audits">
    <meta property="twitter:description" content="Find vulnerabilities in your AI systems before attackers do. Specialized security testing for LLMs, chatbots, and autonomous agents.">
    
    <!-- Canonical -->
    <link rel="canonical" href="https://prompt-guard.netlify.app/">
    
    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="google5e71fc6dfda3c9d4.html" />
    
    <!-- Preconnect to external resources -->
    <link rel="preconnect" href="https://js.stripe.com">
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    
    <title>PromptGuard | Enterprise AI Security Audits</title>
    
    <!-- Schema.org structured data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "PromptGuard",
      "description": "Enterprise AI security audits and vulnerability assessment for LLM systems",
      "url": "https://prompt-guard.netlify.app",
      "telephone": "",
      "email": "promptguardsupport@gmail.com",
      "sameAs": [],
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "US"
      },
      "priceRange": "$500-$7500",
      "offers": [
        {
          "@type": "Offer",
          "name": "Quick Assessment",
          "price": "500",
          "priceCurrency": "USD",
          "description": "10+ test vectors, focused vulnerability scan, basic findings"
        },
        {
          "@type": "Offer",
          "name": "Standard Audit",
          "price": "2500",
          "priceCurrency": "USD",
          "description": "30+ test vectors, 40-hour comprehensive testing, full CVSS scoring, remediation roadmap"
        },
        {
          "@type": "Offer",
          "name": "Comprehensive Review",
          "price": "7500",
          "priceCurrency": "USD",
          "description": "50+ test vectors, multi-model testing, architecture recommendations, post-remediation testing"
        }
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5",
        "ratingCount": "3"
      }
    }
    </script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: #fff;
            color: #1a1a1a;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* ===== HEADER ===== */
        header {
            background: #fff;
            border-bottom: 1px solid #e0e0e0;
            position: sticky;
            top: 0;
            z-index: 100;
            padding: 15px 0;
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 26px;
            font-weight: 700;
            color: #000;
        }

        .logo span {
            color: #d32f2f;
        }

        nav {
            display: flex;
            gap: 30px;
            align-items: center;
        }

        nav a {
            text-decoration: none;
            color: #555;
            font-weight: 500;
            font-size: 15px;
            transition: color 0.2s;
            cursor: pointer;
            padding-bottom: 8px;
            border-bottom: 3px solid transparent;
        }

        nav a:hover {
            color: #d32f2f;
        }

        nav a.active {
            color: #d32f2f;
            border-bottom-color: #d32f2f;
        }

        .btn-primary {
            background: #d32f2f;
            color: white;
            padding: 12px 28px;
            border-radius: 4px;
            border: none;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .btn-primary:hover {
            background: #b71c1c;
        }

        .btn-secondary {
            background: white;
            color: #d32f2f;
            padding: 12px 28px;
            border-radius: 4px;
            border: 2px solid #d32f2f;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-secondary:hover {
            background: #fff5f5;
        }

        /* ===== SECTIONS ===== */
        .tab-content {
            display: none;
            padding: 80px 0;
            animation: fadeIn 0.3s ease-in;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .tab-content h1 {
            font-size: 52px;
            font-weight: 700;
            line-height: 1.1;
            margin-bottom: 30px;
            color: #000;
        }

        .tab-content h2 {
            font-size: 40px;
            font-weight: 700;
            margin-bottom: 40px;
            color: #000;
        }

        .tab-content h3 {
            font-size: 22px;
            font-weight: 600;
            margin-top: 40px;
            margin-bottom: 20px;
            color: #000;
        }

        .tab-content h4 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 12px;
            color: #000;
        }

        .tab-content p {
            color: #555;
            line-height: 1.8;
            margin-bottom: 16px;
            font-size: 16px;
        }

        /* ===== HERO SECTION ===== */
        .hero-intro {
            margin-bottom: 60px;
        }

        .hero-intro .subtitle {
            font-size: 18px;
            color: #666;
            margin-bottom: 30px;
            line-height: 1.8;
            max-width: 800px;
        }

        .hero-intro .highlight {
            color: #d32f2f;
        }

        .cta-buttons {
            display: flex;
            gap: 20px;
            margin-bottom: 60px;
            flex-wrap: wrap;
        }

        .hero-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 40px;
            padding: 40px 0;
            border-top: 1px solid #e0e0e0;
            border-bottom: 1px solid #e0e0e0;
        }

        .stat {
            text-align: left;
        }

        .stat-num {
            font-size: 32px;
            font-weight: 700;
            color: #d32f2f;
            margin-bottom: 4px;
        }

        .stat-label {
            color: #666;
            font-size: 14px;
        }

        /* ===== GRIDS ===== */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: start;
            margin-bottom: 40px;
        }

        .grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
            margin-bottom: 40px;
        }

        .grid-2-wide {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            margin-bottom: 40px;
        }

        /* ===== CARDS ===== */
        .card {
            background: #fafafa;
            padding: 30px;
            border-radius: 4px;
            border-left: 4px solid #d32f2f;
        }

        .card h4 {
            margin-top: 0;
        }

        .card ul {
            list-style: none;
            margin-top: 12px;
        }

        .card li {
            padding: 6px 0;
            color: #555;
            font-size: 14px;
        }

        .card li:before {
            content: "✓ ";
            color: #d32f2f;
            font-weight: 700;
            margin-right: 6px;
        }

        .service-card {
            background: #fafafa;
            padding: 30px;
            border-radius: 4px;
            border-left: 4px solid #d32f2f;
        }

        .service-card h4 {
            margin-top: 0;
            margin-bottom: 12px;
        }

        .service-card p {
            font-size: 14px;
            margin-bottom: 12px;
        }

        .service-card ul {
            list-style: none;
            font-size: 13px;
        }

        .service-card li {
            padding: 4px 0;
            color: #555;
        }

        .service-card li:before {
            content: "→ ";
            color: #d32f2f;
            font-weight: 700;
            margin-right: 6px;
        }

        /* ===== TEAM ===== */
        .team-member {
            background: #fafafa;
            padding: 30px;
            border-radius: 4px;
            text-align: center;
        }

        .team-member h4 {
            margin-top: 0;
            margin-bottom: 4px;
        }

        .team-member .title {
            color: #d32f2f;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 15px;
        }

        .team-member p {
            font-size: 14px;
            color: #666;
        }

        /* ===== METHODOLOGY ===== */
        .methodology-box {
            background: #fafafa;
            padding: 40px;
            border-radius: 4px;
            margin-bottom: 40px;
        }

        .steps-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 20px;
            margin-top: 30px;
        }

        .step-card {
            background: white;
            padding: 25px;
            border-radius: 4px;
            border-left: 4px solid #d32f2f;
            text-align: center;
        }

        .step-num {
            font-size: 28px;
            font-weight: 700;
            color: #d32f2f;
            margin-bottom: 10px;
        }

        .step-card h4 {
            margin-top: 0;
            font-size: 15px;
            margin-bottom: 10px;
        }

        .step-card p {
            font-size: 13px;
            color: #666;
            margin-bottom: 0;
        }

        /* ===== VULNERABILITIES ===== */
        .vuln-item {
            padding: 25px;
            background: #fafafa;
            border-radius: 4px;
            border-left: 4px solid #d32f2f;
            margin-bottom: 20px;
        }

        .vuln-item h5 {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #000;
        }

        .vuln-item p {
            font-size: 14px;
            color: #666;
            margin-bottom: 10px;
        }

        .vuln-example {
            background: white;
            padding: 12px;
            border-radius: 3px;
            font-size: 12px;
            color: #555;
            font-family: monospace;
            margin-top: 10px;
            border-left: 2px solid #d32f2f;
        }

        /* ===== CASE STUDIES ===== */
        .case-study {
            background: #fafafa;
            padding: 40px;
            border-radius: 4px;
            margin-bottom: 30px;
            border-left: 4px solid #d32f2f;
        }

        .case-study h4 {
            margin-top: 0;
            margin-bottom: 10px;
        }

        .case-study .company {
            color: #d32f2f;
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 15px;
        }

        .finding {
            background: white;
            padding: 15px;
            border-radius: 3px;
            margin: 10px 0;
            font-size: 14px;
            color: #555;
            border-left: 3px solid #d32f2f;
        }

        .finding strong {
            color: #000;
        }

        /* ===== PRICING ===== */
        .pricing-card {
            background: #fafafa;
            padding: 35px;
            border-radius: 4px;
            border: 2px solid #e0e0e0;
            transition: all 0.2s;
        }

        .pricing-card:hover {
            border-color: #d32f2f;
            box-shadow: 0 4px 12px rgba(211, 47, 47, 0.1);
        }

        .pricing-card.featured {
            border-color: #d32f2f;
            background: #fff;
            transform: scale(1.02);
        }

        .price-tier {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #000;
        }

        .price {
            font-size: 36px;
            font-weight: 700;
            color: #d32f2f;
            margin-bottom: 4px;
        }

        .price-desc {
            font-size: 13px;
            color: #666;
            margin-bottom: 25px;
            padding-bottom: 25px;
            border-bottom: 1px solid #e0e0e0;
        }

        .pricing-features {
            list-style: none;
            margin-bottom: 25px;
        }

        .pricing-features li {
            padding: 10px 0;
            font-size: 14px;
            color: #555;
        }

        .pricing-features li:before {
            content: "✓ ";
            color: #d32f2f;
            font-weight: 700;
            margin-right: 8px;
        }

        /* ===== TESTIMONIALS ===== */
        .testimonial {
            background: #fafafa;
            padding: 30px;
            border-radius: 4px;
            border-left: 4px solid #d32f2f;
        }

        .testimonial p {
            font-size: 15px;
            color: #555;
            margin-bottom: 15px;
            font-style: italic;
            line-height: 1.8;
        }

        .testimonial-author {
            font-weight: 600;
            color: #000;
            font-size: 14px;
        }

        .testimonial-role {
            color: #d32f2f;
            font-size: 13px;
            margin-top: 4px;
        }

        /* ===== FORMS ===== */
        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: #000;
        }

        input,
        select,
        textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #d0d0d0;
            border-radius: 4px;
            font-size: 14px;
            font-family: inherit;
            transition: border-color 0.2s;
        }

        input:focus,
        select:focus,
        textarea:focus {
            outline: none;
            border-color: #d32f2f;
            box-shadow: 0 0 0 3px rgba(211, 47, 47, 0.1);
        }

        textarea {
            resize: vertical;
            min-height: 100px;
        }

        .btn-submit {
            background: #d32f2f;
            color: white;
            padding: 14px 32px;
            border-radius: 4px;
            border: none;
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            width: 100%;
            transition: background 0.2s;
        }

        .btn-submit:hover {
            background: #b71c1c;
        }

        /* ===== FAQ ===== */
        .faq-item {
            margin-bottom: 30px;
            padding-bottom: 30px;
            border-bottom: 1px solid #e0e0e0;
        }

        .faq-question {
            font-size: 16px;
            font-weight: 600;
            color: #000;
            margin-bottom: 12px;
            cursor: pointer;
        }

        .faq-answer {
            font-size: 15px;
            color: #666;
            line-height: 1.8;
        }

        /* ===== FOOTER ===== */
        footer {
            background: #1a1a1a;
            color: #aaa;
            padding: 50px 0 20px;
            text-align: center;
            font-size: 14px;
            margin-top: 80px;
        }

        footer p {
            margin-bottom: 8px;
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            nav {
                flex-wrap: wrap;
                gap: 15px;
            }

            nav a {
                font-size: 13px;
            }

            .tab-content h1 {
                font-size: 36px;
            }

            .tab-content h2 {
                font-size: 28px;
            }

            .hero-stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .grid-2 {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .grid-3 {
                grid-template-columns: 1fr;
            }

            .grid-2-wide {
                grid-template-columns: 1fr;
            }

            .steps-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .pricing-card.featured {
                transform: scale(1);
            }
        }
    </style>
</head>

<body>
    <!-- HEADER -->
    <header>
        <div class="container">
            <div class="header-content">
                <div class="logo">Prompt<span>Guard</span></div>
                <nav>
                    <a class="tab-link active" onclick="switchTab('home')">Home</a>
                    <a class="tab-link" onclick="switchTab('products')">Products</a>
                    <a class="tab-link" onclick="switchTab('about')">About Us</a>
                    <a class="tab-link" onclick="switchTab('contact')">Contact</a>
                    <button class="btn-primary" onclick="switchTab('contact')">Get Started</button>
                </nav>
            </div>
        </div>
    </header>

    <!-- HOME TAB -->
    <div id="home" class="tab-content active">
        <div class="container">
            <h2 style="margin-bottom: 40px; text-align: center;">Choose Your Service</h2>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 80px;">
                <div style="padding: 40px; background: #fafafa; border-radius: 4px; border-left: 4px solid #d32f2f;">
                    <h3 style="margin-top: 0; color: #000;">PromptGuard</h3>
                    <p style="color: #666; font-size: 15px; margin-bottom: 20px;"><strong>Enterprise AI Security Audits</strong></p>
                    <p style="font-size: 14px; color: #555; margin-bottom: 20px; line-height: 1.6;">Red-team testing for conversational AI, autonomous agents, RAG systems, and LLM implementations. 100+ vulnerability patterns tested with CVSS scoring.</p>
                    <button class="btn-primary" onclick="switchTab('products')" style="width: 100%;">View Pricing</button>
                </div>
                <div style="padding: 40px; background: #fafafa; border-radius: 4px; border-left: 4px solid #d32f2f;">
                    <h3 style="margin-top: 0; color: #000;">SiteCheck</h3>
                    <p style="color: #666; font-size: 15px; margin-bottom: 20px;"><strong>Website Security Reviews</strong></p>
                    <p style="font-size: 14px; color: #555; margin-bottom: 20px; line-height: 1.6;">Fast, affordable security audits for small businesses. Honest assessments of WordPress, WooCommerce, and standard web infrastructure. Start at $99.</p>
                    <button class="btn-primary" onclick="switchTab('products')" style="width: 100%;">View Pricing</button>
                </div>
            </div>

            <div class="hero-intro">
                <h1>Security Auditing You Can <span class="highlight">Trust</span></h1>
                <p class="subtitle">From startup websites to enterprise AI systems, we find vulnerabilities before attackers do. Fast audits, honest findings, actionable recommendations.</p>
                
                <div class="cta-buttons">
                    <button class="btn-primary" onclick="switchTab('products')">See All Offerings</button>
                    <button class="btn-secondary" onclick="switchTab('contact')">Get Started</button>
                </div>

                <div class="hero-stats">
                    <div class="stat">
                        <div class="stat-num">100+</div>
                        <div class="stat-label">Vulnerability Patterns Tested</div>
                    </div>
                    <div class="stat">
                        <div class="stat-num">30+</div>
                        <div class="stat-label">Test Vectors per Audit</div>
                    </div>
                    <div class="stat">
                        <div class="stat-num">40h</div>
                        <div class="stat-label">Standard Audit Duration</div>
                    </div>
                    <div class="stat">
                        <div class="stat-num">CVSS</div>
                        <div class="stat-label">Risk Scoring Included</div>
                    </div>
                </div>
            </div>

            <h2 style="margin-top: 80px;">What We Test</h2>
            <div class="grid-3">
                <div class="service-card">
                    <h4>Prompt Injection</h4>
                    <p>System instructions override attacks through user input</p>
                    <ul>
                        <li>Direct injection attacks</li>
                        <li>Indirect injection vectors</li>
                        <li>Context manipulation</li>
                    </ul>
                </div>

                <div class="service-card">
                    <h4>Data Exfiltration</h4>
                    <p>Extracting sensitive information through model outputs</p>
                    <ul>
                        <li>Training data leakage</li>
                        <li>PII exposure from context</li>
                        <li>Model poisoning risks</li>
                    </ul>
                </div>

                <div class="service-card">
                    <h4>Behavioral Bypass</h4>
                    <p>Circumventing safety guidelines and constraints</p>
                    <ul>
                        <li>Instruction override</li>
                        <li>Role-playing jailbreaks</li>
                        <li>Permission boundary testing</li>
                    </ul>
                </div>

                <div class="service-card">
                    <h4>API Security</h4>
                    <p>Integration point exploitation and endpoint testing</p>
                    <ul>
                        <li>Authentication bypass</li>
                        <li>Rate limiting evasion</li>
                        <li>Privilege escalation</li>
                    </ul>
                </div>

                <div class="service-card">
                    <h4>Input Validation</h4>
                    <p>Traditional security flaws in AI context</p>
                    <ul>
                        <li>SQL/NoSQL injection</li>
                        <li>Command injection attacks</li>
                        <li>Path traversal exploitation</li>
                    </ul>
                </div>

                <div class="service-card">
                    <h4>Function Call Exploit</h4>
                    <p>Malicious manipulation of model tool usage</p>
                    <ul>
                        <li>Unintended function execution</li>
                        <li>Parameter manipulation</li>
                        <li>Chain attack simulation</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- PRODUCTS TAB -->
    <div id="products" class="tab-content">
        <div class="container">
            <h2>Our Services</h2>
            
            <div style="margin-bottom: 100px;">
                <h3 style="margin-top: 0; margin-bottom: 15px;">PromptGuard - Enterprise AI Security Audits</h3>
                <p style="margin-bottom: 40px; color: #666;">Specialized red-team testing for conversational AI, autonomous agents, RAG systems, and custom LLM implementations.</p>
                
                <div class="grid-3">
                    <div class="pricing-card">
                        <div class="price-tier">Quick Assessment</div>
                        <div class="price">$500</div>
                        <div class="price-desc">For basic validation</div>
                        <ul class="pricing-features"><li>10+ test vectors</li><li>Focused vulnerability scan</li><li>Basic report</li><li>24-hour turnaround</li></ul>
                        <button class="btn-primary" onclick="switchTab('contact')" style="width: 100%;">Request</button>
                    </div>
                    <div class="pricing-card featured">
                        <div class="price-tier">Standard Audit</div>
                        <div class="price">$2,500</div>
                        <div class="price-desc">Most popular</div>
                        <ul class="pricing-features"><li>30+ test vectors</li><li>Full attack surface testing</li><li>Detailed report with PoCs</li><li>CVSS scoring</li><li>Remediation roadmap</li><li>40-hour assessment</li></ul>
                        <button class="btn-primary" onclick="switchTab('contact')" style="width: 100%;">Request</button>
                    </div>
                    <div class="pricing-card">
                        <div class="price-tier">Comprehensive Review</div>
